{
  "name": "dm-copilot",
  "version": "1.0.6",
  "description": "Assistente desktop para mestres de RPG de mesa - Crie e gerencie suas campanhas com facilidade",
  "main": "out/main/index.js",
  "author": "DM Copilot Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafarvns/dm-copilot.git"
  },
  "icon": "./src/assets/icons/logo_ico.ico",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-database.js",
    "preview": "electron-vite preview",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "build:win": "node scripts/copy-database.js && electron-vite build && electron-builder --win --publish never",
    "build:linux": "node scripts/copy-database.js && electron-vite build && electron-builder --linux --publish never",
    "build:mac": "node scripts/copy-database.js && electron-vite build && electron-builder --mac --publish never",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "better-sqlite3": "^12.9.0",
    "easymde": "^2.21.0",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "lucide": "^0.460.0",
    "marked": "^18.0.3",
    "node-machine-id": "^1.1.12",
    "socket.io": "^4.8.3",
    "youtube-dl-exec": "^3.0.22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "youtube-dl-exec"
    ]
  }
}
