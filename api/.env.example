# Required. Postgres connection string.
DATABASE_URL=postgres://dmc:dmc@localhost:5432/dmc_licenses?sslmode=disable

# Required. Shared secret for admin endpoints (X-Admin-Key header).
# Generate with: openssl rand -base64 32
ADMIN_API_KEY=change-me

# Optional. HTTP port.
PORT=8080

# Optional. debug | info | warn | error
LOG_LEVEL=info

# Optional. HTTP timeouts (Go duration syntax: "5s", "1m", "500ms").
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# docker-compose only — read by db service.
POSTGRES_USER=dmc
POSTGRES_PASSWORD=dmc
POSTGRES_DB=dmc_licenses
API_PORT=8080
